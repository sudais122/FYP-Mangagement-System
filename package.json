{
  "name": "server",
  "version": "1.0.0",
  "type": "module",
  "main": "Server/server.js",
  "scripts": {
    "start": "node Server/server.js",
    "dev": "nodemon Server/server.js",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --testPathPatterns=tests --forceExit",
    "test:watch": "node --experimental-vm-modules node_modules/.bin/jest --testPathPatterns=tests --watch --forceExit",
    "test:coverage": "node --experimental-vm-modules node_modules/.bin/jest --testPathPatterns=tests --coverage --forceExit"
  },
  "jest": {
    "transform": {},
    "testEnvironment": "node",
    "testTimeout": 15000,
    "globalSetup": "<rootDir>/Server/tests/globalSetup.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1047.0",
    "@aws-sdk/s3-request-presigner": "^3.1050.0",
    "archiver": "^8.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.1",
    "mongoose": "^8.0.0",
    "multer": "^2.4.0",
    "multer-s3": "^3.0.1",
    "nodemailer": "^10.1.0",
    "resend": "^6.12.3",
    "winston": "^3.19.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-latest/xlsx-latest.tgz"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
